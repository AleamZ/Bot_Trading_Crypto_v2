NODE_ENV=development
PORT=8787

EXECUTION_MODE=paper

# Legacy single-account configuration. Will be removed after account-scoped trading migration.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

DATABASE_URL=
