{
  "name": "bot-trade-future-binance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @smc-futures-bot/api",
    "dev:web": "npm run dev -w @smc-futures-bot/web",
    "build:api": "npm run build -w @smc-futures-bot/api",
    "build:web": "npm run build -w @smc-futures-bot/web",
    "build": "npm run build:api && npm run build:web",
    "start:api": "npm run start -w @smc-futures-bot/api",
    "test": "npm run test -w @smc-futures-bot/api",
    "typecheck": "npm run typecheck -w @smc-futures-bot/api && npm run typecheck -w @smc-futures-bot/web"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
