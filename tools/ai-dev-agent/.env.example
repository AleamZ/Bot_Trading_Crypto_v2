# AI Dev Agent - copy to tools/ai-dev-agent/.env (gitignored) and adjust.

# --- Local OpenAI-compatible LLM ---
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=local-model
AI_TIMEOUT_MS=300000
AI_TEMPERATURE=0.2

# --- Repository & logs ---
# Relative paths are resolved from tools/ai-dev-agent (REPO_PATH) / the repo root (LOG_PATHS).
REPO_PATH=../..
LOG_PATHS=logs/smc-futures-api/out.log,logs/smc-futures-api/error.log
GIT_REMOTE=origin
BASE_BRANCH=dat-dev

# --- Scheduling / signal gate ---
INTERVAL_MINUTES=30
MIN_NEW_LINES=200
MIN_SIGNAL_EVENTS=20
MAX_READ_BYTES=20971520
DIGEST_MAX_CHARS=6000

# --- Patch limits ---
MAX_FILES=8
MAX_CHANGED_LINES=400
MAX_READ_FILES=6
MAX_FILE_CHARS=14000
MAX_FIX_ATTEMPTS=2
MAX_OPEN_AI_PRS=1

# --- Worktree ---
# Empty = <OS temp>/ai-dev-agent-worktrees
WORKTREE_DIR=
# link = junction/symlink node_modules from the repo (fast); ci = npm ci inside the worktree (isolated, slower)
WORKTREE_INSTALL=link
TEST_TIMEOUT_MS=900000

# --- Safety ---
# Dry-run is ON unless this is exactly "false". In dry-run nothing is committed, pushed or opened as a PR.
AI_DEV_AGENT_DRY_RUN=true
